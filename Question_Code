-- 1--
select a.category,sum(a.price*b.quantity) as total_revenue from order_items b join products a on a.product_id=b.product_id
group by a.category;
-- 2 --
with ok as(select a.customer_id as customer_id,a.customer_name as customer_name,sum(b.price*c.quantity) as total_revenue
 from customers a join orders d on a.customer_id=d.customer_id
join order_items c on c.order_id=d.order_id join products b on b.product_id=c.product_id group by a.customer_id,a.customer_name)
select * from(select customer_id,customer_name,total_revenue,dense_rank() over(order by total_revenue desc) as rn from ok) as t 
where rn=1;
-- 3 --
with ok as(select a.product_name as product_name,sum(b.quantity) as sold_quantity 
from products a join order_items b on a.product_id=b.product_id group by a.product_name)
select * from(select product_name,sold_quantity,dense_rank() over(order by sold_quantity desc) as rn from ok) as t 
where rn<=3;
-- 4 --
select a.customer_name,count(b.order_id) as total_orders from customers a left join orders b on a.customer_id=b.customer_id
group by a.customer_name;
-- 5 --
select a.customer_name,b.order_id as total_quantity from customers a left join orders b on a.customer_id=b.customer_id where b.order_id is null;
-- 6 --
with ok as(select a.order_id as order_id,sum(a.quantity*b.price) as total_revenue
 from order_items a join products b on a.product_id=b.product_id group by a.order_id)
select * from(select order_id,total_revenue,dense_rank() over(order by total_revenue desc) as rn from ok) as t 
where rn=1;
-- 7 --
with ok as(select a.order_date as order_date,sum(c.quantity*b.price) as total_revenue 
from orders a join order_items c on a.order_id=c.order_id
join products b on b.product_id=c.product_id group by a.order_date)
select order_date,total_revenue,sum(total_revenue) over(order by order_date) as runing_total from ok;

-- 8 --
select * from(select *,dense_rank() over(partition by category order by price desc) as rn from products) as t 
where rn=1;
-- 9 --
select * from(select a.customer_id,a.customer_name,b.order_date,dense_rank() over(partition by a.customer_id order by b.order_date desc) as rn 
from customers a join orders b on a.customer_id=b.customer_id) as t 
where rn=1;
